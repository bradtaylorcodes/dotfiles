#!/usr/bin/env bash

set -euo pipefail

# default_paths are searched on every machine. This file (one dir per line,
# # comments allowed) adds extra per-machine roots on top of them. It lives
# outside the dotfiles repo, so it is machine-local.
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/herdr-sessionizer/paths"

default_paths=(
  "$HOME/personal"
)

herdr="${HERDR_BIN_PATH:-herdr}"

# Emit search roots one per line: the built-in defaults, then any extra roots
# from CONFIG_FILE (added on top, not replacing the defaults).
read_search_paths() {
  printf '%s\n' "${default_paths[@]}"

  [[ -f "$CONFIG_FILE" ]] || return 0
  local line
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"                       # strip comments
    line="${line#"${line%%[![:space:]]*}"}"  # trim leading whitespace
    line="${line%"${line##*[![:space:]]}"}"  # trim trailing whitespace
    [[ -z "$line" ]] && continue
    printf '%s\n' "${line/#\~/$HOME}"         # expand a leading ~
  done <"$CONFIG_FILE"
}

if [[ $# -eq 1 ]]; then
  selected="$1"
else
  # Keep roots that exist (a stale entry never aborts the picker) and drop
  # duplicates so a config root repeating a default is not listed twice.
  existing=()
  seen=""
  while IFS= read -r path; do
    [[ -d "$path" ]] || continue
    case "$seen" in *"|$path|"*) continue ;; esac
    seen="$seen|$path|"
    existing+=("$path")
  done < <(read_search_paths)

  if [[ ${#existing[@]} -eq 0 ]]; then
    echo "herdr-sessionizer: no search roots exist (checked $CONFIG_FILE / defaults)" >&2
    exit 1
  fi

  selected=$(find "${existing[@]}" -mindepth 1 -maxdepth 1 -type d | fzf) || exit 0
fi

[[ -z "$selected" ]] && exit 0

label=$(basename "$selected")

workspace_id=$("$herdr" workspace list |
  jq -r --arg l "$label" '.result.workspaces[] | select(.label == $l) | .workspace_id' |
  head -n 1)

if [[ -n "$workspace_id" ]]; then
  "$herdr" workspace focus "$workspace_id" >/dev/null
else
  "$herdr" workspace create --cwd "$selected" --label "$label" --focus >/dev/null
fi
